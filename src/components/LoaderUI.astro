---
// src/components/LoaderUI.astro
const currentYear = new Date().getFullYear();
---

<div class="absolute inset-0 z-40 flex flex-col justify-between p-4 md:p-6 pointer-events-none">
  <div id="loader-top" class="w-full flex justify-between items-center border-b border-white/10 pb-2 text-[10px] tracking-widest text-white/60 font-mono -translate-y-20 opacity-0">
    <div class="flex items-center gap-2">
      <span class="inline-block w-1.5 h-1.5 bg-[#EE8027] rounded-full animate-pulse"></span>
      <span class="text-white font-bold">KITTEEK // STUDIO_BOOT</span>
    </div>
    <div class="hidden md:flex gap-6 text-[9px]">
      <span>ENGINE: ACTIVE</span>
      <span>UI_DEPLOY_READY</span>
    </div>
    <span>[ BRAND_CORE_{currentYear} ]</span>
  </div>

  <div id="loader-bottom" class="w-full flex flex-col md:flex-row justify-between items-stretch md:items-end gap-4 border-t border-white/10 pt-4 translate-y-20 opacity-0">
    <div class="flex flex-col font-mono">
      <div class="text-[9px] text-white/30 uppercase tracking-[0.2em]">Compiling Creative Assets</div>
      <div class="flex items-baseline gap-2">
        <span id="progress-text" class="text-5xl md:text-7xl font-display font-black text-white tracking-tighter">00%</span>
        <span class="text-[#64bbb3] text-[10px] font-bold animate-pulse tracking-wider">DEV_SYNC</span>
      </div>
    </div>
    <div class="flex-grow max-w-xl flex flex-col justify-end gap-2 font-mono">
      <div class="w-full h-1 bg-white/5 relative overflow-hidden">
        <div id="progress-fill" class="absolute top-0 left-0 h-full w-0 bg-[#EE8027] shadow-[0_0_10px_#EE8027]"></div>
      </div>
      <div class="flex justify-between text-[8px] text-white/20 font-bold">
        <span>PIXELS_AND_CODE_RECV_OK</span>
        <svg class="w-16 h-3 text-white/20" viewBox="0 0 100 20" fill="currentColor">
          <rect x="0" width="3" height="20"/><rect x="5" width="1" height="20"/><rect x="8" width="4" height="20"/>
          <rect x="15" width="2" height="20"/><rect x="20" width="1" height="20"/><rect x="23" width="6" height="20"/>
        </svg>
      </div>
    </div>
  </div>
</div>