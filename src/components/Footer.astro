---
// Footer.astro - Edición Especial Landing Page
// Diseño Urbano, Cargado e Industrial Avanzado
---

<footer class="terminal-footer">

  <!-- Contenedor Principal en Cuadrícula -->
  <div class="footer-core-grid">
    
    <!-- Módulo 01: Marca Gigante con Estilo .EXE -->
    <div class="brand-panel">
      <div class="panel-badge">CORE_FILE: LRM.DAT</div>
      <h2 class="giant-brand-title">
        LOREM<span class="outlined-text">.IPSUM</span>
      </h2>
      <p class="brand-paragraph">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam elementum sodales mauris, ut finibus elit pretium ac. 
      </p>
      <div class="tech-specs">
        <span class="spec-item">V.1_BUILD_2026</span>
        <span class="spec-item">LOC // 00_MNG</span>
      </div>
    </div>

    <!-- Módulo 02: Anclajes de Sección en formato Fila de Datos -->
    <div class="navigation-panel">
      <div class="module-header">
        <span class="module-num">[ 01 ]</span>
        <span class="module-title">INDEX_ANCHORS</span>
      </div>
      <nav class="anchor-nav">
        <a href="#top" class="anchor-link">
          <span class="prefix">[+]</span>
          <span class="text">LOREM_HERO</span>
        </a>
        <a href="#" class="anchor-link">
          <span class="prefix">[+]</span>
          <span class="text">IPSUM_ABOUT</span>
        </a>
        <a href="#" class="anchor-link">
          <span class="prefix">[+]</span>
          <span class="text">DOLOR_SERVICES</span>
        </a>
        <a href="#" class="anchor-link">
          <span class="prefix">[+]</span>
          <span class="text">AMET_PROJECTS</span>
        </a>
      </nav>
    </div>

    <!-- Módulo 03: Ranura Estilo Cartucho de Contacto/Acción -->
    <div class="action-panel">
      <div class="cartridge-box">
        <div class="cartridge-top">
          <span class="cartridge-label">INPUT_SLOT.EXE</span>
          <div class="tech-squares">
            <span></span><span></span><span></span>
          </div>
        </div>
        <div class="cartridge-body">
          <p class="cartridge-text">LOREM IPSUM DOLOR SIT AMET CONSECTETUR ADIPISCING ELIT.</p>
          
          <div class="fake-form-group">
            <div class="fake-input-field">LOREM_EMAIL@IPSUM.COM</div>
            <button class="brutal-submit-btn" aria-label="Action Button">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

  </div>

  <!-- Barra Flotante Inferior (Estilo Dock) -->
  <div class="footer-dock-bottom">
    <div class="dock-wrapper">
      <div class="dock-credits">
        <span>LOREM IPSUM © 2026</span>
        <span class="dock-separator">//</span>
        <span>ALL_SYSTEMS_VERIFIED</span>
      </div>
      <div class="dock-decorations">
        <span class="decor-box solid"></span>
        <span class="decor-box orange"></span>
        <span class="decor-box border"></span>
      </div>
    </div>
  </div>
</footer>

<style>
  /* --- CONFIGURACIÓN DE ESTILO CORPORATIVO URBANO --- */
  .terminal-footer {
    --color-dark: #0a0b0d;
    --color-panel: #13151a;
    --color-orange: #ff7300;
    --color-teal: #4ade80;
    --color-beige: #e3dfd5;
    --color-muted: #6e7582;
    
    background-color: var(--color-dark);
    color: var(--color-beige);
    font-family: 'Courier New', Courier, monospace;
    text-transform: uppercase;
    padding: 0 0 2rem 0;
    position: relative;
    border-top: 4px solid var(--color-beige);
    overflow: hidden;
  }

  /* --- REJILLA CENTRAL CARGADA --- */
  .footer-core-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1.2fr;
    gap: 2.5rem;
    padding: 4rem 2rem;
    max-width: 1440px;
    margin: 0 auto;
  }

  @media (max-width: 1024px) {
    .footer-core-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 2.5rem 1.5rem;
    }
  }

  /* --- MÓDULO DE MARCA --- */
  .panel-badge {
    display: inline-block;
    background-color: var(--color-orange);
    color: var(--color-dark);
    font-weight: 900;
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    margin-bottom: 0.5rem;
  }

  .giant-brand-title {
    font-family: 'Arial Black', Impact, sans-serif;
    font-size: clamp(3.5rem, 6vw, 5.5rem);
    line-height: 0.85;
    margin: 0 0 1.5rem 0;
    letter-spacing: -3px;
    color: var(--color-beige);
  }

  .outlined-text {
    color: transparent;
    -webkit-text-stroke: 2px var(--color-orange);
  }

  .brand-paragraph {
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.5;
    max-width: 480px;
    margin-bottom: 2rem;
  }

  .tech-specs {
    display: flex;
    gap: 1.5rem;
    font-size: 0.75rem;
    color: var(--color-muted);
    border-left: 2px solid var(--color-orange);
    padding-left: 0.8rem;
  }

  /* --- MÓDULO ANCLAJES (FILAS DE DATOS) --- */
  .module-header {
    display: flex;
    gap: 0.5rem;
    font-weight: bold;
    border-bottom: 2px dashed #2a2d35;
    padding-bottom: 0.8rem;
    margin-bottom: 1.5rem;
  }

  .module-num {
    color: var(--color-orange);
  }

  .module-title {
    color: var(--color-muted);
  }

  .anchor-nav {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .anchor-link {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background-color: var(--color-panel);
    border: 1px solid #2a2d35;
    padding: 0.8rem 1rem;
    color: var(--color-beige);
    text-decoration: none;
    font-weight: bold;
    font-size: 0.95rem;
    transition: transform 0.1s steps(2), border-color 0.2s;
  }

  .anchor-link .prefix {
    color: var(--color-teal);
  }

  .anchor-link:hover {
    border-color: var(--color-orange);
    transform: translateX(4px);
    background-color: #191c22;
  }

  /* --- MÓDULO CARTUCHO DE CONTACTO --- */
  .cartridge-box {
    background-color: var(--color-panel);
    border: 2px solid var(--color-beige);
    box-shadow: 6px 6px 0px var(--color-orange);
    position: relative;
  }

  .cartridge-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-beige);
    color: var(--color-dark);
    padding: 0.5rem 1rem;
    font-weight: 900;
    font-size: 0.8rem;
  }

  .tech-squares {
    display: flex;
    gap: 4px;
  }

  .tech-squares span {
    width: 6px;
    height: 6px;
    background-color: var(--color-dark);
  }

  .cartridge-body {
    padding: 1.5rem;
  }

  .cartridge-text {
    font-size: 0.85rem;
    line-height: 1.4;
    color: var(--color-muted);
    margin: 0 0 1.5rem 0;
  }

  .fake-form-group {
    display: flex;
    border: 2px solid var(--color-beige);
    background-color: var(--color-dark);
  }

  .fake-input-field {
    flex-grow: 1;
    padding: 0.8rem;
    font-size: 0.85rem;
    color: var(--color-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    align-self: center;
  }

  .brutal-submit-btn {
    background-color: var(--color-orange);
    color: var(--color-dark);
    border: none;
    border-left: 2px solid var(--color-beige);
    padding: 0 1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.1s;
  }

  .brutal-submit-btn:hover {
    background-color: var(--color-teal);
  }

  /* --- DOCK INFERIOR ESTILO TERMINAL --- */
  .footer-dock-bottom {
    max-width: 1440px;
    margin: 2rem auto 0 auto;
    padding: 0 2rem;
  }

  .dock-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: var(--color-panel);
    border: 2px solid #2a2d35;
    padding: 1rem 1.5rem;
  }

  .dock-credits {
    font-size: 0.8rem;
    font-weight: bold;
    color: var(--color-muted);
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .dock-separator {
    color: var(--color-orange);
  }

  .dock-decorations {
    display: flex;
    gap: 6px;
  }

  .decor-box {
    width: 14px;
    height: 14px;
  }
  .decor-box.solid { background-color: var(--color-beige); }
  .decor-box.orange { background-color: var(--color-orange); }
  .decor-box.border { border: 2px solid var(--color-muted); }

  @media (max-width: 600px) {
    .footer-dock-bottom {
      padding: 0 1rem;
    }
    .dock-wrapper {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }
  }
</style>