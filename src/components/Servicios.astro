<style>
  .text-stroke-2 { -webkit-text-stroke: 1.5px; }
  .stroke-accent { -webkit-text-stroke-color: #ff7300; }
  
  .perspective-container {
    perspective: 1200px;
    perspective-origin: 50% 50%;
  }

  .cassette-scene {
    transform-style: preserve-3d;
    position: relative;
    z-index: 1;
  }

  .cassette-scene.is-active {
    z-index: 100 !important; 
  }

  .cassette-box {
    transform-style: preserve-3d;
    transform: rotateX(15deg) rotateY(35deg) rotateZ(-5deg);
  }

  .cassette-scene:not(.is-locked-parent):hover .cassette-box {
    transform: rotateX(10deg) rotateY(25deg) rotateZ(-2deg) scale(1.05);
  }

  .box-front { transform: translateZ(20px); }
  .box-back { transform: translateZ(-20px); }
  .box-spine { left: 0; transform: translateX(-50%) rotateY(-90deg); }
  .tape-slide { transform: translateZ(0px); }

  .cassette-scene.is-active .cassette-box {
    transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(1.1);
  }

  .cassette-scene.is-active .tape-slide {
    transform: translateZ(0px) translateX(95%);
  }

  @media (max-width: 1023px) {
    .cassette-scene.is-active .tape-slide {
      transform: translateZ(0px) translateX(40%);
    }
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initServices() {
    const track = document.getElementById('cassette-track') as HTMLElement | null;
    const cassettes = document.querySelectorAll('.cassette-scene');
    
    // Elementos del Modal Móvil
    const mobileModal = document.getElementById('mobile-service-modal');
    const closeBtn = document.getElementById('close-mobile-modal');
    const modalId = document.getElementById('modal-id');
    const modalTitle = document.getElementById('modal-title');
    const modalTitleSub = document.getElementById('modal-title-sub');
    const modalColorBar = document.getElementById('modal-color-bar');
    const modalOnline = document.getElementById('modal-online');
    const modalOnlineDot = document.getElementById('modal-online-dot');
    const modalCatBox = document.getElementById('modal-cat-box');
    const modalCat = document.getElementById('modal-cat');
    const modalSpecs = document.getElementById('modal-specs');
    const modalReview = document.getElementById('modal-review');

    if (!track) return;

    let activeCassetteRef: Element | null = null;

    let carruselTween = gsap.to(track, {
      xPercent: -50,
      ease: "none",
      duration: 40,
      repeat: -1
    });

    track.addEventListener('mouseenter', () => {
      if (!track.classList.contains('is-locked')) carruselTween.pause();
    });
    
    track.addEventListener('mouseleave', () => {
      if (!track.classList.contains('is-locked')) carruselTween.play();
    });

    const closeActiveCassette = () => {
      if (!activeCassetteRef) return;

      const cassette = activeCassetteRef;
      track.classList.remove('is-locked');
      cassette.classList.remove('is-active');
      cassettes.forEach(c => c.classList.remove('is-locked-parent'));

      if (window.innerWidth < 1024 && mobileModal) {
        gsap.to(mobileModal, {
          autoAlpha: 0,
          pointerEvents: 'none',
          duration: 0.3
        });
      } else {
        const infoPanel = cassette.querySelector('.service-info');
        gsap.to(infoPanel, { autoAlpha: 0, x: -30, duration: 0.3 });
      }

      setTimeout(() => {
        gsap.to('.cassette-scene', { opacity: 1, pointerEvents: 'auto', duration: 0.4 });
        gsap.to(track, { 
          x: 0, 
          duration: 0.6, 
          ease: "power3.inOut", 
          onComplete: () => { 
            carruselTween.play(); 
            activeCassetteRef = null;
          }
        });
      }, 300);
    };

    if (closeBtn) {
      closeBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeActiveCassette();
      });
    }

    if (mobileModal) {
      mobileModal.addEventListener('click', (e) => {
        if (e.target === mobileModal) {
          closeActiveCassette();
        }
      });
    }

    const toggleCassette = (cassette: Element) => {
        const isActive = cassette.classList.contains('is-active');
        if (track.classList.contains('is-locked') && !isActive) return;

        if (isActive) {
          closeActiveCassette();
        } else {
          activeCassetteRef = cassette;
          track.classList.add('is-locked');
          cassettes.forEach(c => c.classList.add('is-locked-parent'));
          carruselTween.pause();

          cassettes.forEach(c => {
            if (c !== cassette) {
              gsap.to(c, { opacity: 0, pointerEvents: 'none', duration: 0.4 });
            }
          });

          gsap.to(cassette, { opacity: 1, duration: 0.4 });

          const rect = cassette.getBoundingClientRect();
          const isMobile = window.innerWidth < 1024;
          const targetX = isMobile ? (window.innerWidth / 2) - (rect.width / 2) : window.innerWidth * 0.15;
          const currentX = parseFloat(gsap.getProperty(track, "x") as string) || 0;
          const shiftNeeded = targetX - rect.left;

          gsap.to(track, {
            x: currentX + shiftNeeded,
            duration: 0.8,
            ease: "power3.inOut",
            onComplete: () => {
              cassette.classList.add('is-active');
              
              if (isMobile && mobileModal) {
                // Rellenar datos en el modal móvil dinámicamente
                const ds = (cassette as HTMLElement).dataset;
                if (modalId) modalId.textContent = `SYS_FILE // ${ds.id}`;
                
                const titleParts = (ds.titulo || '').split('_');
                if (modalTitle) modalTitle.childNodes[0].textContent = titleParts[0] + ' ';
                if (modalTitleSub) {
                  modalTitleSub.textContent = titleParts[1] || 'SYS';
                  modalTitleSub.style.webkitTextStroke = `1px ${ds.color}`;
                }

                if (modalColorBar) modalColorBar.style.backgroundColor = ds.color || '#ff7300';
                if (modalOnline) modalOnline.style.color = ds.color || '#ff7300';
                if (modalOnlineDot) {
                  modalOnlineDot.style.backgroundColor = ds.color || '#ff7300';
                  modalOnlineDot.style.color = ds.color || '#ff7300';
                }
                if (modalCatBox) modalCatBox.style.borderColor = ds.color || '#ff7300';
                if (modalCat) modalCat.textContent = ds.tag || '';
                if (modalSpecs) modalSpecs.textContent = (ds.specs || '').split(' | ')[0];
                if (modalReview) modalReview.textContent = ds.review || '';

                // Animación de entrada modal
                gsap.fromTo(mobileModal, 
                  { autoAlpha: 0, pointerEvents: 'none' },
                  { autoAlpha: 1, pointerEvents: 'auto', duration: 0.35 }
                );
                gsap.fromTo('#modal-card-content',
                  { scale: 0.85, y: 20 },
                  { scale: 1, y: 0, duration: 0.35, ease: "back.out(1.2)" }
                );

              } else {
                // Desktop
                const infoPanel = cassette.querySelector('.service-info');
                gsap.fromTo(infoPanel, 
                  { autoAlpha: 0, x: -30 },
                  { autoAlpha: 1, pointerEvents: 'auto', duration: 0.4 }
                );
              }
            }
          });
        }
    };

    cassettes.forEach((cassette) => {
      cassette.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleCassette(cassette);
      });
      cassette.addEventListener('keydown', (e) => {
        const keyboardEvent = e as KeyboardEvent;
        if (keyboardEvent.key === 'Enter' || keyboardEvent.key === ' ') {
          keyboardEvent.preventDefault();
          keyboardEvent.stopPropagation();
          toggleCassette(cassette);
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initServices);
  document.addEventListener('astro:page-load', initServices); 
</script>