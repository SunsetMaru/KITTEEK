---
const team = [
  { name: 'DEV', role: 'FRONTEND // SYS', img: '/ASSETS/IMG/CHAR1.png' },
  { name: 'PIXEL', role: 'UI/UX // DESIGN', img: '/ASSETS/IMG/CHAR2.png' },
  { name: 'BOSS', role: 'DIRECTOR // LEAD', img: '/ASSETS/IMG/CHAR3.png' },
  { name: 'GFX', role: 'MOTION // ART', img: '/ASSETS/IMG/CHAR4.png' },
  { name: 'SYNTAX', role: 'BACKEND // OPS', img: '/ASSETS/IMG/CHAR5.png' },
  { name: 'LOGIC', role: 'DATA // NODE', img: '/ASSETS/IMG/CHAR6.png' },
];
---

<section id="about" class="w-full min-h-screen flex items-center justify-center bg-[#0a0b0d] border-y-8 border-[#ff7300] font-sans text-[#e3dfd5] overflow-hidden selection:bg-[#4ade80] selection:text-[#0a0b0d]">

  <div class="w-full max-w-[1400px] mx-auto px-6 py-12 flex flex-col lg:flex-row gap-10 items-center">
    
    <div class="w-full lg:w-4/12 flex flex-col">
      <div class="inline-block bg-[#4ade80] text-[#0a0b0d] font-mono text-[10px] font-bold px-2 py-1 mb-4 self-start border border-[#4ade80]">
        FILE: ABOUT_US.DAT
      </div>
      
      <h2 class="text-5xl md:text-7xl font-black uppercase tracking-tighter leading-none mb-5">
        WE ARE <br/> 
        <span class="text-[#ff7300]">KITTEEK</span>
      </h2>
      
      <p class="text-base font-bold mb-5 border-l-4 border-[#4ade80] pl-4 text-[#e3dfd5]/80">
        Prueba, prueba
      </p>

      <ul class="font-mono text-[11px] space-y-1.5 text-[#4ade80] flex flex-col">
        <li>[+] WEB_DEVELOPMENT</li>
        <li>[+] BRANDING_SYSTEMS</li>
        <li>[+] UI_UX_OVERDRIVE</li>
        <li>[+] MOTION_GRAPHICS</li>
      </ul>
    </div>

    <div class="w-full lg:w-8/12 grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-5">
      {team.map((member) => (
        <article class="group relative bg-[#13151a] border-2 border-[#e3dfd5] p-1.5 hover:border-[#ff7300] transition-colors duration-300 shadow-[4px_4px_0px_#ff7300]">
          
          <div class="w-full bg-[#0a0b0d] aspect-square overflow-hidden border border-[#6e7582]/40 relative">
            <!-- Performance: Native lazy loading and async decoding to defer off-screen images -->
            <img loading="lazy" decoding="async"
              src={member.img} 
              alt={member.name} 
              class="w-full h-full object-cover filter grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-105 transition-all duration-300"
            />
            <div class="absolute top-2 right-2 w-2 h-2 bg-[#ff7300] rounded-full animate-pulse opacity-0 group-hover:opacity-100"></div>
          </div>

          <div class="mt-2 pb-1 border-b-2 border-[#6e7582]/40 group-hover:border-[#4ade80] transition-colors">
            <h3 class="text-xl font-black uppercase tracking-tighter text-[#e3dfd5] leading-none">{member.name}</h3>
            <p class="text-[#4ade80] font-mono text-[9px] mt-1 font-bold tracking-widest">{member.role}</p>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>