---
// Hero.astro
---

<section class="relative w-full h-screen bg-transparent overflow-hidden flex flex-col items-center justify-center font-sans text-[#EACCB0] uppercase select-none group/stage">

  <div class="js-top-tab opacity-0 -translate-y-10 z-40 relative flex items-end drop-shadow-[0_10px_20px_rgba(238,128,39,0.3)]">
    <div class="w-6 h-8 bg-[#0a0a0a] clip-diagonal-left border-l-[3px] border-t-[3px] border-[#EE8027]"></div>
    
    <div class="bg-[#EE8027] text-black px-10 py-2 relative border-x-[4px] border-t-[4px] border-black pb-1">
      <span class="text-[#EACCB0] block tracking-[0.2em] text-center text-base font-black drop-shadow-[2px_2px_0px_#000]">AGENCY_ONLINE</span>
      <div class="flex items-center justify-center gap-2 mt-0.5">
        <span class="w-2 h-2 bg-black animate-pulse"></span>
        <span class="text-black text-[10px] block font-mono font-black tracking-widest uppercase">KITTEEK DIGITAL STUDIO</span>
      </div>
    </div>
    
    <div class="w-6 h-8 bg-[#0a0a0a] clip-diagonal-right border-r-[3px] border-t-[3px] border-[#EE8027]"></div>
  </div>

  <div class="js-main-frame opacity-0 scale-[0.9] relative w-full max-w-[1500px] aspect-video lg:h-[78vh] bg-[#111] border-[8px] border-[#0a0a0a] rounded-[2.5rem] shadow-[0_40px_100px_rgba(0,0,0,0.9),inset_0_0_0_2px_rgba(234,204,176,0.1)] overflow-hidden z-30 grid grid-cols-12 clip-main-chassis">
    
    <div class="col-span-12 md:col-span-6 bg-[#EE8027] relative overflow-hidden flex flex-col justify-between p-8 border-r-[4px] border-[#0a0a0a] shadow-[inset_-20px_0_50px_rgba(0,0,0,0.5)]">
      
      <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#000_2px,transparent_2px)] [background-size:10px_10px]"></div>
      <div class="absolute -top-6 -left-10 w-[150%] h-6 bg-[repeating-linear-gradient(-45deg,#000,#000_15px,#EE8027_15px,#EE8027_30px)] transform rotate-3 z-10 border-y border-black/50 shadow-md"></div>

      <div class="absolute top-0 -left-4 font-black text-[30vw] md:text-[22vw] leading-none tracking-tighter italic select-none pointer-events-none font-sans z-0 mix-blend-overlay opacity-50">
        <span class="absolute top-2 left-2 text-black blur-[4px]">K</span>
        <span class="relative text-[#ff9f59] text-stroke-3">K</span>
      </div>

      <div class="absolute top-1/4 left-8 text-[#EACCB0] font-black text-6xl -rotate-90 origin-bottom-left flex items-center gap-4 opacity-10">
        <span>←</span><span>SYSTEM</span>
      </div>

      <div class="absolute inset-x-0 bottom-[-5%] h-[115%] w-full z-10 js-character pointer-events-none transform origin-bottom translate-y-12">
        <img 
          src="/public/ASSETS/IMG/CHAR1.png" 
          alt="Kitteek Agent" 
          class="w-full h-full object-contain object-bottom filter drop-shadow-[25px_0_40px_rgba(0,0,0,0.8)] saturate-110 contrast-125"
        />
        <div class="absolute bottom-10 left-1/2 -translate-x-1/2 w-3/4 h-1/2 bg-[#EACCB0]/10 blur-[100px] -z-10 rounded-full"></div>
      </div>

      <div class="absolute right-6 md:right-10 bottom-12 z-30 js-hero-text flex flex-col items-end max-w-lg">
        
        <div class="bg-[#EACCB0] text-black px-4 py-1 text-[10px] font-black tracking-widest transform skew-x-[15deg] translate-x-2 border-b-2 border-black flex items-center gap-2">
          <span class="w-2 h-2 bg-[#EE8027] rounded-full animate-ping"></span>
          INICIAR_SISTEMA
        </div>

        <div class="bg-[#0a0a0a]/95 backdrop-blur-xl p-6 md:p-8 border-[3px] border-[#EACCB0]/90 shadow-[10px_10px_0px_rgba(0,0,0,0.6)] transform -skew-x-[8deg] relative overflow-hidden group">
          <div class="absolute top-0 left-0 w-[200%] h-[1px] bg-[#64bbb3] opacity-50 transform -translate-x-1/2 rotate-45 animate-laser-scan pointer-events-none"></div>
          
          <div class="relative transform skew-x-[8deg]">
            <span class="block text-xs font-mono text-[#EE8027] tracking-widest font-bold uppercase mb-2">// AGENCIA CREATIVA</span>
            
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-[#EACCB0] tracking-tighter leading-[0.9] drop-shadow-[2px_2px_0px_#EE8027] mb-4">
              DISEÑO QUE <br/><span class="text-transparent text-stroke-2 stroke-accent">IMPACTA</span>
            </h1>
            
            <p class="text-[#EACCB0]/80 font-sans font-bold text-sm md:text-base leading-snug mb-6 max-w-sm">
              Construimos interfaces letales, marcas memorables y código que domina la red. Puro poder visual para tu corporación.
            </p>

            <button class="bg-[#EE8027] text-black font-black uppercase text-sm px-6 py-3 border-2 border-transparent hover:border-[#EACCB0] hover:bg-transparent hover:text-[#EACCB0] transition-colors">
              Explorar Proyectos
            </button>
          </div>
        </div>
      </div>
    </div>

    <div class="hidden md:flex col-span-2 bg-[#171717] relative border-r-[4px] border-[#0a0a0a] flex-col items-center justify-between py-12 px-2 overflow-hidden z-20 shadow-[0_0_30px_rgba(0,0,0,0.8)_inset]">
      
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 border-[20px] border-dashed border-[#EACCB0]/5 rounded-full animate-spin-slow pointer-events-none"></div>
      <div class="absolute inset-0 opacity-[0.15] bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSIyNCIgaGVpZ2h0PSI0MCIgdmlld0JveD0iMCAwIDI0IDQwIj48cGF0aCBkPSJNMCAwbDEyIDIwdjIwbC0xMi0yMHYtMjB6IiBmaWxsPSIjZmZmIiBmaWxsLW9wYWNpdHk9IjAuMSIvPjwvc3ZnPg==')]"></div>
      
      <div class="js-center-details flex flex-col items-center text-center relative z-10 w-full mt-4">
        <h3 class="text-7xl font-black tracking-tighter text-transparent text-stroke-2 stroke-accent drop-shadow-[5px_5px_0px_rgba(0,0,0,1)] relative">
          V.1
          <span class="absolute top-0 left-0 text-[#EACCB0] clip-half-text">V.1</span>
        </h3>
        <div class="mt-4 border-y border-[#EACCB0]/20 py-1 w-full text-center bg-[#0a0a0a]/50 backdrop-blur-sm">
          <span class="text-[9px] font-mono text-[#64bbb3] font-bold tracking-[0.3em]">SYSTEM_CORE</span>
        </div>
      </div>
    </div>

    <div class="col-span-12 md:col-span-4 bg-[#212121] relative overflow-hidden flex flex-col justify-between p-8 z-10">

      <div class="absolute inset-0 z-0 select-none pointer-events-none flex items-center justify-center">
        <img src="/public/ASSETS/IMG/CHAR3.png" alt="Secondary Agent" class="w-[150%] h-[150%] object-cover object-center filter grayscale contrast-[1.3] brightness-75 mix-blend-screen opacity-50" />
        <div class="absolute inset-0 bg-[linear-gradient(rgba(0,0,0,0.5)_2px,transparent_2px)] bg-[size:100%_4px]"></div>
      </div>

      <div class="js-tv-widget absolute right-8 top-1/3 z-30 w-32 h-32 bg-[#EE8027] rounded-[2rem] border-[6px] border-[#0a0a0a] shadow-[12px_12px_0px_rgba(0,0,0,1),inset_0_5px_15px_rgba(234,204,176,0.3)] flex flex-col items-center justify-center p-3 group cursor-pointer hover:brightness-110 transition-all">
        <div class="absolute -top-6 left-6 w-2 h-8 bg-[#0a0a0a] rotate-[-25deg] origin-bottom rounded-t-sm group-hover:rotate-[-35deg] transition-transform duration-300"></div>
        <div class="absolute -top-8 right-6 w-1.5 h-10 bg-[#0a0a0a] rotate-[35deg] origin-bottom rounded-t-sm group-hover:rotate-[45deg] transition-transform duration-300"></div>
        
        <div class="w-full h-full bg-[#0a0a0a] rounded-xl flex items-center justify-center overflow-hidden relative shadow-[inset_0_0_20px_rgba(0,0,0,0.9)] border-2 border-black/50">
          <div class="absolute top-0 left-0 w-full h-1/2 bg-gradient-to-b from-[#EACCB0]/10 to-transparent z-20"></div>
          <div class="absolute inset-0 bg-[linear-gradient(rgba(234,204,176,0.1)_1px,transparent_1px)] bg-[size:100%_3px] z-10"></div>
          
          <div class="flex flex-col items-center relative z-0">
            <svg class="w-8 h-8 text-[#EE8027] animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span class="text-[8px] font-mono text-[#EE8027] font-black mt-1 tracking-widest drop-shadow-[0_0_5px_#EE8027]">REC</span>
          </div>
        </div>
      </div>

      <div class="js-right-panel-text flex justify-between items-end z-20 mt-auto border-t-[2px] border-[#EACCB0]/20 pt-6 relative bg-gradient-to-t from-[#212121] to-transparent">
        <div class="relative">
          <span class="text-xs font-mono font-bold text-[#64bbb3] block mb-1 tracking-widest">DRIVE_ACTIVE //</span>
          <span class="text-4xl md:text-5xl font-black text-[#EACCB0] tracking-tighter leading-none block relative z-10">CREATIVE</span>
          <span class="text-4xl md:text-5xl font-black text-[#EE8027] tracking-tighter leading-none block absolute top-1 -left-1 -z-10 mix-blend-screen">CREATIVE</span>
        </div>
      </div>

    </div>
  </div>

  <div class="js-bottom-tab opacity-0 translate-y-10 z-40 relative flex items-start drop-shadow-[0_-10px_20px_rgba(0,0,0,0.5)]">
    <div class="w-4 h-6 bg-[#0a0a0a] clip-diagonal-left-bottom border-l-[3px] border-b-[3px] border-[#0a0a0a]"></div>
    
    <div class="bg-[#0a0a0a] text-[#EACCB0] px-12 py-3 font-black text-xs tracking-widest border-x-[4px] border-b-[4px] border-[#0a0a0a] flex items-center space-x-6 relative pb-4 shadow-[inset_0_-2px_10px_rgba(234,204,176,0.1)]">
      <div class="absolute bottom-0 left-0 w-8 h-1 bg-[repeating-linear-gradient(45deg,#000,#000_2px,#EE8027_2px,#EE8027_4px)]"></div>
      <div class="absolute bottom-0 right-0 w-8 h-1 bg-[repeating-linear-gradient(45deg,#000,#000_2px,#64bbb3_2px,#64bbb3_4px)]"></div>

      <span class="text-[#EACCB0] tracking-widest font-black text-sm">STATUS_OK</span>
      <div class="h-4 w-[1px] bg-[#EACCB0]/30"></div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 bg-[#64bbb3] shadow-[0_0_10px_#64bbb3] rounded-sm animate-pulse"></span>
        <span class="text-[#64bbb3] font-mono text-[10px] tracking-widest">ALL_SYS_ONLINE</span>
      </div>
    </div>

    <div class="w-4 h-6 bg-[#0a0a0a] clip-diagonal-right-bottom border-r-[3px] border-b-[3px] border-[#0a0a0a]"></div>
  </div>

</section>

<style>
  .clip-main-chassis {
    clip-path: polygon(
      3rem 0, 
      calc(100% - 3rem) 0, 
      100% 3rem, 
      100% calc(100% - 3rem), 
      calc(100% - 3rem) 100%, 
      3rem 100%, 
      0 calc(100% - 3rem), 
      0 3rem
    );
  }

  .clip-diagonal-left { clip-path: polygon(0 100%, 100% 0, 100% 100%); }
  .clip-diagonal-right { clip-path: polygon(0 0, 100% 100%, 0 100%); }
  .clip-diagonal-left-bottom { clip-path: polygon(100% 0, 100% 100%, 0 0); }
  .clip-diagonal-right-bottom { clip-path: polygon(0 0, 0 100%, 100% 0); }

  .text-stroke-2 { -webkit-text-stroke: 2px; }
  .text-stroke-3 { -webkit-text-stroke: 3px; }
  .stroke-accent { -webkit-text-stroke-color: #EACCB0; }
  
  .clip-half-text {
    clip-path: polygon(0 0, 100% 0, 100% 50%, 0 50%);
    color: #EE8027;
  }

  @keyframes spin-slow {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  .animate-spin-slow {
    animation: spin-slow 15s linear infinite;
  }

  @keyframes pulse-fast {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
  .animate-pulse-fast {
    animation: pulse-fast 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes laser-scan {
    0% { top: -10%; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { top: 110%; opacity: 0; }
  }
  .animate-laser-scan {
    animation: laser-scan 3s ease-in-out infinite;
  }

  .js-main-frame, .js-character, .js-tv-widget, .js-hero-text {
    will-change: transform, opacity;
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }
</style>

<script>
  import { gsap } from 'gsap';

  function initExtremeInterface() {
    const tl = gsap.timeline({ defaults: { ease: 'power4.out' } });

    gsap.set(['.js-top-tab', '.js-main-frame', '.js-bottom-tab', '.js-character', '.js-hero-text', '.js-center-details', '.js-right-panel-text', '.js-tv-widget'], { opacity: 0 });
    gsap.set('.js-main-frame', { scale: 0.9, rotationX: 5 }); 
    
    tl
      .to('.js-main-frame', { opacity: 1, scale: 1, rotationX: 0, duration: 1, ease: 'expo.out' })
      .to('.js-top-tab', { opacity: 1, y: 0, duration: 0.6, ease: 'back.out(1.5)' }, '-=0.6')
      .to('.js-bottom-tab', { opacity: 1, y: 0, duration: 0.6, ease: 'back.out(1.5)' }, '-=0.5')
      .fromTo('.js-character', 
        { y: 150, scale: 0.9, opacity: 0 },
        { opacity: 1, y: 0, scale: 1, duration: 1.2, ease: 'elastic.out(1, 0.8)' }, '-=0.4'
      )
      .from('.js-hero-text', { x: 100, rotationY: -45, opacity: 0, duration: 0.8, ease: 'power3.out' }, '-=0.8')
      .to('.js-hero-text', { opacity: 1, duration: 0.1 }, '-=0.8')
      .to('.js-center-details', { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, ease: 'back.out(1.2)' }, '-=0.6')
      .to('.js-right-panel-text', { opacity: 1, y: 0, duration: 0.5, stagger: 0.1 }, '-=0.5')
      .fromTo('.js-tv-widget', 
        { scale: 0, rotation: -20, opacity: 0 },
        { opacity: 1, scale: 1, rotation: 0, duration: 0.8, ease: 'elastic.out(1.2, 0.5)' }, '-=0.6'
      );

    const stage = document.querySelector('.group\\/stage') as HTMLElement;
    if(stage) {
      stage.addEventListener('mousemove', (e) => {
        const { clientX, clientY } = e;
        const centerX = window.innerWidth / 2;
        const centerY = window.innerHeight / 2;
        
        const moveX = (clientX - centerX) * 0.02;
        const moveY = (clientY - centerY) * 0.02;
        
        gsap.to('.js-main-frame', { rotationY: moveX * 0.5, rotationX: -moveY * 0.5, duration: 1.5, ease: 'power2.out' });
        gsap.to('.js-character', { x: moveX * 2, y: moveY * 1, duration: 0.8, ease: 'power2.out' });
        gsap.to('.js-hero-text', { x: moveX * 1.5, y: moveY * 0.8, duration: 1, ease: 'power2.out' });
        gsap.to('.js-tv-widget', { x: -moveX * 1.2, y: -moveY * 1.2, rotation: moveX * 0.4, duration: 1.2, ease: 'power2.out' });
        gsap.to('.js-center-details', { x: -moveX * 0.5, duration: 1.5, ease: 'power2.out' });
      });

      stage.addEventListener('mouseleave', () => {
        gsap.to('.js-main-frame', { rotationY: 0, rotationX: 0, duration: 1, ease: 'power2.out' });
        gsap.to(['.js-character', '.js-hero-text', '.js-tv-widget', '.js-center-details'], { x: 0, y: 0, rotation: 0, duration: 1, ease: 'power2.out' });
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initExtremeInterface);
  document.addEventListener('astro:page-load', initExtremeInterface);
</script>