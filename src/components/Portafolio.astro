            <button class="js-close-modal-btn w-full py-2 mt-0.5 bg-transparent hover:bg-[#e3dfd5]/5 border border-[#e3dfd5]/20 text-[#e3dfd5] font-mono text-[9px] md:text-[10px] uppercase tracking-widest transition-colors flex items-center justify-center gap-2 cursor-pointer pointer-events-auto">
