                      {proyecto.codigoCorto}
                    </span>
                  </div>

                  <div class="mt-auto mb-3">
                    <h3 class="text-3xl md:text-4xl font-black text-[#e3dfd5] tracking-tighter leading-[0.85] uppercase drop-shadow-[2px_2px_0px_#0a0b0d]">
                      {proyecto.cliente}
                    </h3>
                    <div class="flex items-center gap-2 mt-2">
                      <div class="h-[1.5px] w-6 bg-[#e3dfd5]"></div>
