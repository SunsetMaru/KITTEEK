</section>

<!-- VISOR PDF -->
<div id="pdf-viewer-modal" class="fixed inset-0 z-[9999] bg-[#0a0b0d]/95 backdrop-blur-md hidden flex-col items-center justify-center p-2 md:p-6 opacity-0 transition-opacity duration-300">
  
  <div class="w-full max-w-[95vw] lg:max-w-[1400px] bg-[#4ade80] flex justify-between items-center px-4 py-3 border-x-4 border-t-4 border-[#0a0b0d]">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 bg-[#0a0b0d] rounded-full animate-pulse"></span>
      <span class="font-mono text-[#0a0b0d] font-black text-sm md:text-base tracking-widest">SYS_VIEWER // HIGH_RES_DATA</span>
    </div>
    
    <button id="close-pdf-modal" class="font-black text-[#0a0b0d] hover:text-[#e3dfd5] transition-colors text-sm md:text-base px-2 cursor-pointer">
      [X] CERRAR
    </button>
  </div>
  
  <div class="w-full max-w-[95vw] lg:max-w-[1400px] h-[90vh] bg-[#13151a] border-x-4 border-b-4 border-[#0a0b0d] relative shadow-[0_0_50px_rgba(255,115,0,0.2)] flex flex-col items-center overflow-auto custom-scrollbar" id="pdf-container">
      
     <div id="pdf-loader" class="absolute inset-0 flex flex-col items-center justify-center text-[#4ade80] bg-[#13151a] z-50 hidden">
        <div class="w-12 h-12 border-4 border-dashed border-[#4ade80]/30 border-t-[#4ade80] rounded-full animate-spin"></div>
        <span class="mt-4 font-mono font-bold text-xs tracking-widest animate-pulse">DECODIFICANDO DATOS...</span>
     </div>
     
     <div id="pdf-pages-wrapper" class="w-full px-2 md:px-8 py-6 flex flex-col items-center gap-4"></div>
  </div>

</div>

<style>
  .text-stroke-2 { -webkit-text-stroke: 1.5px; }
  .stroke-accent { -webkit-text-stroke-color: #ff7300; }
  .perspective-1000 { perspective: 1000px; }
  
  .clip-cartridge {
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);
  }
  
  #pdf-viewer-modal {
    user-select: none;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 14px; 
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #0a0b0d; 
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #4ade80; 
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #e3dfd5; 
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initPortfolio() {
    const modalWrapper = document.getElementById('project-modal');
    const backdrop = document.getElementById('project-modal-backdrop');
    const cards = document.querySelectorAll('.js-project-card');
    const modalContents = document.querySelectorAll('.js-modal-content');
    const closeBtns = document.querySelectorAll('.js-close-modal-btn');
    
    let activeModalContent: HTMLElement | null = null;
    let isAnimating = false;

    // Entrada animada inicial del grid
    gsap.from('.js-project-card', {
      scrollTrigger: {
        trigger: '#portfolio',
        start: 'top 70%',
      },
      y: 80,
      scale: 0.95,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: 'power3.out'
    });

    // Abrir Modal
    cards.forEach((card) => {
      card.addEventListener('click', () => {
        if (isAnimating) return;
        const index = card.getAttribute('data-index');
        const targetContent = document.querySelector(`.js-modal-content[data-modal-index="${index}"]`) as HTMLElement;

        if (targetContent && modalWrapper && backdrop) {
          isAnimating = true;
          activeModalContent = targetContent;

          const lenis = (window as any).lenis;
          if (lenis) lenis.stop();

          // Mostrar contenedor global
          modalWrapper.classList.remove('hidden');
          modalWrapper.classList.add('flex');
          targetContent.classList.remove('hidden');
          targetContent.classList.add('flex');

          const detailedDisc = targetContent.querySelector('.detailed-disc') as HTMLElement;

          // Animar backdrop
          gsap.to(backdrop, { opacity: 1, duration: 0.3 });

          // Animar Modal y Disco
          gsap.fromTo(targetContent, 
            { opacity: 0, scale: 0.8 }, 
            { opacity: 1, scale: 1, duration: 0.5, ease: "back.out(1.2)" }
          );

          if (detailedDisc) {
            gsap.fromTo(detailedDisc, 
              { rotation: -180 }, 
              {
                rotation: 0,
                duration: 0.9,
                ease: "power3.out",
                onComplete: () => { isAnimating = false; }
              }
            );
          } else {
            isAnimating = false;
          }
        }
      });
    });

    // Función para cerrar Modal
    const closeModal = () => {
      if (isAnimating || !activeModalContent || !modalWrapper || !backdrop) return;
      isAnimating = true;

      gsap.to(backdrop, { opacity: 0, duration: 0.3 });
      gsap.to(activeModalContent, {
        opacity: 0,
        scale: 0.8,
        duration: 0.3,
        ease: "power2.in",
        onComplete: () => {
          if (activeModalContent) {
            activeModalContent.classList.add('hidden');
            activeModalContent.classList.remove('flex');
          }
          modalWrapper.classList.add('hidden');
          modalWrapper.classList.remove('flex');

          const lenis = (window as any).lenis;
          if (lenis) lenis.start();

          activeModalContent = null;
          isAnimating = false;
        }
      });
    };

    closeBtns.forEach((btn) => btn.addEventListener('click', closeModal));
    if (backdrop) backdrop.addEventListener('click', closeModal);

    // === PDF.JS BEHANCE STYLE ===
    const pdfjsLib = (window as any)['pdfjs-dist/build/pdf'];
    if(pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    const pdfButtons = document.querySelectorAll('.js-view-pdf-btn');
    const modalPdf = document.getElementById('pdf-viewer-modal');
    const closeModalPdfBtn = document.getElementById('close-pdf-modal');
    const pdfContainer = document.getElementById('pdf-container');
    const pagesWrapper = document.getElementById('pdf-pages-wrapper');
    const loader = document.getElementById('pdf-loader');
    
    let currentPdfDoc: any = null;

    const renderAllPages = async (pdfDoc: any) => {
      if (!pagesWrapper || !pdfContainer) return;
      const containerWidth = pdfContainer.clientWidth;

      for (let num = 1; num <= pdfDoc.numPages; num++) {
        const page = await pdfDoc.getPage(num);
        const unscaledViewport = page.getViewport({ scale: 1 });
        
        const scale = (containerWidth * 0.98) / unscaledViewport.width; 
        const finalScale = scale > 4 ? 4 : scale; 
        const viewport = page.getViewport({ scale: finalScale });

        const canvas = document.createElement('canvas');
        canvas.className = 'w-full shadow-2xl pointer-events-auto block mb-2 bg-white';
        canvas.height = viewport.height;
        canvas.width = viewport.width;
        
        pagesWrapper.appendChild(canvas);

        const ctx = canvas.getContext('2d');
        const renderCtx = { canvasContext: ctx, viewport: viewport };

        await page.render(renderCtx).promise;
      }
    };

    pdfButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const pdfUrl = (btn as HTMLElement).getAttribute('data-pdf');
        
        if (pdfUrl && modalPdf && pdfjsLib && loader && pagesWrapper) {
          modalPdf.classList.remove('hidden');
          modalPdf.classList.add('flex');
          loader.classList.remove('hidden'); 
          pagesWrapper.innerHTML = ''; 
          
          setTimeout(() => {
            modalPdf.classList.remove('opacity-0');
            modalPdf.classList.add('opacity-100');
          }, 10);

          loader.innerHTML = `
            <div class="w-12 h-12 border-4 border-dashed border-[#4ade80]/30 border-t-[#4ade80] rounded-full animate-spin"></div>
            <span class="mt-4 font-mono font-bold text-xs tracking-widest animate-pulse">DECODIFICANDO DATOS...</span>
          `;

          pdfjsLib.getDocument(pdfUrl).promise.then((pdfDoc: any) => {
            currentPdfDoc = pdfDoc;
            loader.classList.add('hidden'); 
            renderAllPages(pdfDoc);
          }).catch((err: any) => {
            loader.innerHTML = `<span class="text-[#ff2a2a]">[!] ERROR: NO SE PUDO DECODIFICAR EL ARCHIVO</span>`;
            console.error("Error cargando PDF: ", err);
          });
        }
      });
    });

    if (closeModalPdfBtn && modalPdf) {
      closeModalPdfBtn.addEventListener('click', () => {
        modalPdf.classList.remove('opacity-100');
        modalPdf.classList.add('opacity-0');
        setTimeout(() => {
          modalPdf.classList.add('hidden');
          modalPdf.classList.remove('flex');
          if(pagesWrapper) pagesWrapper.innerHTML = ''; 
          currentPdfDoc = null;
        }, 300);
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initPortfolio);
  document.addEventListener('astro:page-load', initPortfolio);
</script>