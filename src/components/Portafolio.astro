        <span class="mt-4 font-mono font-bold text-xs tracking-widest animate-pulse">DECODIFICANDO DATOS...</span>
     </div>
     
     <div id="pdf-pages-wrapper" class="w-full px-2 md:px-8 py-6 flex flex-col items-center gap-4"></div>
  </div>

</div>

<style>
  .text-stroke-2 { -webkit-text-stroke: 1.5px; }
  .stroke-accent { -webkit-text-stroke-color: #ff7300; }
  .perspective-1000 { perspective: 1000px; }
  
  .clip-cartridge {
    clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 12px, 100% 100%, 0 100%);
  }
  
  .card-opened {
    visibility: hidden;
    pointer-events: none;
  }
  
  #pdf-viewer-modal {
    user-select: none;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 14px; 
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #0a0b0d; 
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #4ade80; 
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #e3dfd5; 
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initPortfolio() {
    const section = document.getElementById('portfolio');

    const cards = document.querySelectorAll('.js-project-card');
    let activeCard: HTMLElement | null = null;
    let isAnimating = false;

    gsap.from('.js-project-card', {
      scrollTrigger: {
        trigger: '#portfolio',
        start: 'top 70%',
      },
      y: 80,
      scale: 0.95,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: 'power3.out'
    });

    cards.forEach((cardEl) => {
      const card = cardEl as HTMLElement;
      const closedState = card.querySelector('.card-closed') as HTMLElement;
      const openedState = card.querySelector('.card-opened') as HTMLElement;
      const detailedDisc = card.querySelector('.detailed-disc') as HTMLElement;
      const closeBtn = card.querySelector('.js-close-btn') as HTMLElement;

      const toggleCard = (e?: Event) => {
        if (e) e.stopPropagation();
        if (isAnimating) return;
        
        const isOpening = activeCard !== card;

        if (isOpening) {
          isAnimating = true;
          activeCard = card;

          if (section) section.style.zIndex = '999';

          cards.forEach(c => {
            if (c !== card) {
              gsap.to(c, { opacity: 0, scale: 0.9, pointerEvents: 'none', duration: 0.4 });
            }
          });

          const lenis = (window as any).lenis;
          if (lenis) {
            const cardRect = card.getBoundingClientRect();
            const offset = -(window.innerHeight / 2) + (cardRect.height / 2);
            
            lenis.scrollTo(card, { 
              offset: offset, 
              duration: 0.6
            });
          } else {
             card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }

          setTimeout(() => {
            if (lenis) lenis.stop();

            const rect = card.getBoundingClientRect();
            const targetX = (window.innerWidth / 2) - (rect.left + rect.width / 2);
            const targetY = (window.innerHeight / 2) - (rect.top + rect.height / 2);

            gsap.set(card, { zIndex: 50 });

            gsap.to(closedState, { opacity: 0, scale: 0.8, duration: 0.4, ease: "power2.in" });
            gsap.set(openedState, { visibility: 'visible', pointerEvents: 'auto' });
            
            gsap.to(card, { x: targetX, y: targetY, duration: 0.8, ease: "power4.out" });
            gsap.to(openedState, { opacity: 1, scale: 1, duration: 0.8, ease: "power4.out", delay: 0.1 });

            gsap.fromTo(detailedDisc, { rotation: -180 }, {
              rotation: 0,
              duration: 1.2,
              ease: "back.out(1.4)",
              delay: 0.3,
              onComplete: () => { isAnimating = false; }
            });
          }, 650);

        } else {
          isAnimating = true;
          activeCard = null;

          gsap.to(openedState, {
            opacity: 0, scale: 0.8, duration: 0.5, ease: "power3.in",
            onComplete: () => { gsap.set(openedState, { visibility: 'hidden', pointerEvents: 'none' }); }
          });

          gsap.to(card, {
            x: 0, y: 0, duration: 0.8, ease: "power3.inOut",
            onComplete: () => { 
              gsap.set(card, { zIndex: 10 }); 
              
              // DEVOLVEMOS TODO A LA NORMALIDAD
              if (section) section.style.zIndex = '10';
              const lenis = (window as any).lenis;
              if (lenis) lenis.start();

              isAnimating = false; 
            }
          });

          gsap.to(closedState, { opacity: 1, scale: 1, duration: 0.6, delay: 0.2, ease: "power2.out" });

          cards.forEach(c => {
            if (c !== card) {
              gsap.to(c, { opacity: 1, scale: 1, pointerEvents: 'auto', duration: 0.5, delay: 0.3 });
            }
          });
        }
      };

      card.addEventListener('click', () => {
        if (!activeCard) toggleCard();
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          if (activeCard === card) toggleCard(e);
        });
      }
    });

    document.addEventListener('click', (e) => {
      const modal = document.getElementById('pdf-viewer-modal');
      if (modal && !modal.classList.contains('hidden')) return;

      if (activeCard && !isAnimating) {
        const target = e.target as HTMLElement;
        if (!activeCard.contains(target)) {
          const closeBtn = activeCard.querySelector('.js-close-btn') as HTMLElement;
          if (closeBtn) closeBtn.click();
        }
      }
    });

    // === PDF.JS BEHANCE STYLE ===
    const pdfjsLib = (window as any)['pdfjs-dist/build/pdf'];
    if(pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }

    const pdfButtons = document.querySelectorAll('.js-view-pdf-btn');
    const modal = document.getElementById('pdf-viewer-modal');
    const closeModalBtn = document.getElementById('close-pdf-modal');
    const pdfContainer = document.getElementById('pdf-container');
    const pagesWrapper = document.getElementById('pdf-pages-wrapper');
    const loader = document.getElementById('pdf-loader');
    
    let currentPdfDoc: any = null;

    const renderAllPages = async (pdfDoc: any) => {
      if (!pagesWrapper || !pdfContainer) return;
      const containerWidth = pdfContainer.clientWidth;

      for (let num = 1; num <= pdfDoc.numPages; num++) {
        const page = await pdfDoc.getPage(num);
        const unscaledViewport = page.getViewport({ scale: 1 });
        
        const scale = (containerWidth * 0.98) / unscaledViewport.width; 
        const finalScale = scale > 4 ? 4 : scale; 
        const viewport = page.getViewport({ scale: finalScale });

        const canvas = document.createElement('canvas');
        canvas.className = 'w-full shadow-2xl pointer-events-auto block mb-2 bg-white';
        canvas.height = viewport.height;
        canvas.width = viewport.width;
        
        pagesWrapper.appendChild(canvas);

        const ctx = canvas.getContext('2d');
        const renderCtx = { canvasContext: ctx, viewport: viewport };

        await page.render(renderCtx).promise;
      }
    };

    pdfButtons.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const pdfUrl = (btn as HTMLElement).getAttribute('data-pdf');
        
        if (pdfUrl && modal && pdfjsLib && loader && pagesWrapper) {
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          loader.classList.remove('hidden'); 
          pagesWrapper.innerHTML = ''; 
          
          setTimeout(() => {
            modal.classList.remove('opacity-0');
            modal.classList.add('opacity-100');
          }, 10);

          loader.innerHTML = `
            <div class="w-12 h-12 border-4 border-dashed border-[#4ade80]/30 border-t-[#4ade80] rounded-full animate-spin"></div>
            <span class="mt-4 font-mono font-bold text-xs tracking-widest animate-pulse">DECODIFICANDO DATOS...</span>
          `;

          pdfjsLib.getDocument(pdfUrl).promise.then((pdfDoc: any) => {
            currentPdfDoc = pdfDoc;
            loader.classList.add('hidden'); 
            renderAllPages(pdfDoc);
          }).catch((err: any) => {
            loader.innerHTML = `<span class="text-[#ff2a2a]">[!] ERROR: NO SE PUDO DECODIFICAR EL ARCHIVO</span>`;
            console.error("Error cargando PDF: ", err);
          });
        }
      });
    });

    if (closeModalBtn && modal) {
      closeModalBtn.addEventListener('click', () => {
        modal.classList.remove('opacity-100');
        modal.classList.add('opacity-0');
        setTimeout(() => {
          modal.classList.add('hidden');
          modal.classList.remove('flex');
          if(pagesWrapper) pagesWrapper.innerHTML = ''; 
          currentPdfDoc = null;
        }, 300);
      });
    }
    
    if (modal) {
      modal.addEventListener('contextmenu', (e) => e.preventDefault());
    }
  }

  document.addEventListener('DOMContentLoaded', initPortfolio);
  document.addEventListener('astro:page-load', initPortfolio);
</script>