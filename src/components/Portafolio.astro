---

<section id="portfolio" class="relative z-10 w-full font-sans select-none pt-32 pb-32 overflow-hidden bg-[#0a0b0d] transition-all duration-300">

  <div class="relative z-10 px-4 md:px-8 xl:px-0 max-w-[1500px] mx-auto w-full">
    
    <div class="mb-16 flex flex-col md:flex-row items-end justify-between border-b-[3px] border-[#e3dfd5]/20 pb-4 relative">
      <div class="relative z-10">
        <h2 class="text-6xl md:text-7xl lg:text-8xl font-black tracking-tighter leading-[0.85] text-[#e3dfd5] drop-shadow-[4px_4px_0px_#13151a]">
          PROYECTOS<span class="text-transparent text-stroke-2 stroke-accent"> RECIENTES</span>
        </h2>
      </div>
      <p class="text-[#e3dfd5]/40 font-mono text-xs max-w-sm text-right mt-4 md:mt-0">
        > SELECCIONA UN CARTUCHO PARA CARGAR EL DISCO Y LEER LOS DATOS CLASIFICADOS.
      </p>
    </div>

    <!-- GRID DE CARTUCHOS -->
    <div id="portfolio-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-y-16 gap-x-8 place-items-center relative z-10">
      
      {proyectos.map((proyecto, index) => (
        <article class="relative w-full max-w-[340px] aspect-[4/3] group cursor-pointer perspective-1000 z-10 js-project-card overflow-visible" data-index={index}>
          
          <div class="card-closed absolute inset-0 transition-opacity duration-300">
            <div class="absolute top-[4%] bottom-[4%] right-[2%] aspect-square rounded-full shadow-[15px_15px_25px_rgba(10,11,13,0.9)] transition-all duration-[700ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:translate-x-[45%] group-hover:rotate-[180deg] group-hover:scale-[1.02] flex items-center justify-center border-[2px] border-[#0a0b0d]/90 z-0 bg-[#13151a]"
                 style={`-webkit-mask-image: radial-gradient(circle, transparent 13%, black 13.5%); mask-image: radial-gradient(circle, transparent 13%, black 13.5%); box-shadow: 0 0 0 2px ${proyecto.color}40 inset;`}>
              
              <!-- Performance: Native lazy loading and async decoding to defer off-screen images -->
                <img loading="lazy" decoding="async" src={proyecto.img} alt={proyecto.cliente} class="absolute inset-0 w-full h-full object-cover opacity-70 mix-blend-luminosity contrast-[1.3] group-hover:opacity-100 transition-opacity" />
              <div class="absolute inset-0 mix-blend-color opacity-50" style={`background-color: ${proyecto.color};`}></div>

              <div class="absolute inset-0 border-[6px] border-[#0a0b0d]/40 rounded-full m-2 pointer-events-none"></div>
              <div class="absolute inset-0 border border-[#e3dfd5]/10 rounded-full m-0.5 pointer-events-none"></div>

              <div class="absolute top-2 w-full text-center text-[8px] font-mono font-black tracking-[0.2em] text-[#e3dfd5]/70 drop-shadow-md">
                {proyecto.codigoCorto}
              </div>
            </div>

            <div class="absolute inset-y-0 left-0 w-[86%] bg-[#0a0b0d] border-t-[2px] border-l-[2px] border-[#e3dfd5]/10 border-r-[4px] border-b-[4px] border-[#13151a] shadow-[15px_15px_30px_rgba(10,11,13,0.9),inset_0_0_40px_rgba(10,11,13,0.6)] overflow-hidden flex z-20 clip-cartridge">
              
              <div class="w-10 h-full bg-[#13151a] flex flex-col items-center py-3 justify-between border-r border-[#e3dfd5]/5 relative z-30 shadow-[5px_0_10px_rgba(10,11,13,0.8)]">
                <div class="w-6 h-6 rounded-sm border-[2px] flex items-center justify-center text-[#0a0b0d] font-black text-[10px]" style={`background-color: ${proyecto.color}; border-color: ${proyecto.color};`}>
                  {index + 1}
                </div>
                <div class="transform -rotate-90 text-[8px] font-mono text-[#e3dfd5]/50 font-black tracking-[0.3em] whitespace-nowrap mt-8 w-[200px] text-center">
                  {proyecto.id}
                </div>
                <div class="w-full px-2 mt-auto opacity-30 flex flex-col gap-[2px]">
                  <div class="h-[2px] bg-[#e3dfd5]"></div><div class="h-[1px] bg-[#e3dfd5]"></div><div class="h-[3px] bg-[#e3dfd5]"></div><div class="h-[1px] bg-[#e3dfd5]"></div>
                </div>
              </div>

              <div class="flex-grow relative overflow-hidden bg-[#13151a]">
                
                <!-- Performance: Native lazy loading and async decoding to defer off-screen images -->
