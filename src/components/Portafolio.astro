                       <span class="w-3 h-3 bg-[#e3dfd5] text-[#0a0b0d] text-[6px] flex items-center justify-center font-black rounded-[2px]">A</span>
                       <span class="w-3 h-3 border border-[#e3dfd5]/30 text-[#e3dfd5] text-[6px] flex items-center justify-center font-black rounded-[2px]">B</span>
                     </div>
                     <span class="text-[6px] font-mono text-[#e3dfd5]/50 text-right max-w-[100px] uppercase">
                       SYS_KT_00{index+1}
                     </span>
                  </div>
                </div>

                <div class="absolute top-1/4 -right-10 w-[150%] h-5 transform rotate-[-35deg] border-y border-[#0a0b0d] shadow-[0_5px_15px_rgba(10,11,13,0.6)] z-40 opacity-90 mix-blend-hard-light" 
                     style={`background: repeating-linear-gradient(45deg, #0a0b0d, #0a0b0d 6px, ${proyecto.color} 6px, ${proyecto.color} 12px);`}>
                </div>

                <div class="absolute inset-0 bg-gradient-to-tr from-[#e3dfd5]/5 via-transparent to-[#e3dfd5]/10 pointer-events-none z-50"></div>
                <div class="absolute top-0 left-0 w-[200%] h-[200%] bg-gradient-to-b from-[#e3dfd5]/10 to-transparent transform -rotate-45 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-50"></div>
              </div>
            </div>
          </div>
        </article>
      ))}

    </div>
  </div>

  <!-- MODAL INDEPENDIENTE Y SOBRE TODO EL DOM (Z-INDEX SUPERIOR) -->
  <!-- MODAL INDEPENDIENTE Y SOBRE TODO EL DOM (Z-INDEX SUPERIOR) -->
  <div id="project-modal" class="fixed inset-0 z-[9900] hidden items-center justify-center p-2 sm:p-4">
    <!-- Backdrop Borroso -->
    <div id="project-modal-backdrop" class="absolute inset-0 bg-[#0a0b0d]/80 backdrop-blur-md opacity-0 transition-opacity duration-300"></div>

    <!-- Contenido del Modal Centrado (Subido en móvil con top-[45%] y md:top-1/2) -->
    {proyectos.map((proyecto, index) => (
      <div class="js-modal-content hidden absolute top-[45%] md:top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[92vw] sm:w-[95vw] max-w-[900px] max-h-[85vh] md:max-h-[90vh] z-10 flex-col md:flex-row gap-4 md:gap-8 items-center justify-start md:justify-center p-3 md:p-2 overflow-y-auto custom-scrollbar" data-modal-index={index}>
        
        <!-- Disco reducido en móviles (160px) para ahorrar espacio vertical -->
        <div class="detailed-disc w-[160px] sm:w-[220px] md:w-[45%] aspect-square rounded-full flex-shrink-0 flex items-center justify-center border-[3px] md:border-[4px] border-[#0a0b0d]/90 bg-[#13151a] shadow-[0_0_40px_rgba(0,0,0,0.8)] relative my-2 md:my-0"
             style={`-webkit-mask-image: radial-gradient(circle, transparent 13%, black 13.5%); mask-image: radial-gradient(circle, transparent 13%, black 13.5%); box-shadow: 0 0 0 4px ${proyecto.color}60 inset;`}>
          
          <!-- Performance: Native lazy loading and async decoding to defer off-screen images -->
                <img loading="lazy" decoding="async" src={proyecto.img} alt={proyecto.cliente} class="absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-luminosity contrast-[1.3]" />
          <div class="absolute inset-0 mix-blend-color opacity-50" style={`background-color: ${proyecto.color};`}></div>
          
          <div class="absolute inset-0 border-[8px] md:border-[12px] border-[#0a0b0d]/50 rounded-full m-2 md:m-3 pointer-events-none"></div>
          <div class="absolute inset-0 border border-[#e3dfd5]/20 rounded-full m-1 pointer-events-none"></div>
          <div class="absolute inset-[25%] border-[2px] border-[#e3dfd5]/10 rounded-full pointer-events-none"></div>
          <div class="absolute inset-[35%] border-[1px] border-[#e3dfd5]/20 rounded-full pointer-events-none border-dashed"></div>

          <div class="absolute inset-[15%] rounded-full border border-[#e3dfd5]/5 opacity-40">
            <div class="w-full h-full transform rotate-[45deg] bg-[linear-gradient(45deg,transparent_45%,rgba(227,223,213,0.05)_50%,transparent_55%)]"></div>
          </div>

          <div class="absolute top-[18%] md:top-[20%] w-full text-center text-[8px] md:text-[10px] font-mono font-black tracking-[0.2em] text-[#e3dfd5]/90 drop-shadow-md">
            {proyecto.codigoCorto} // {proyecto.id}
          </div>
          <div class="absolute bottom-[18%] md:bottom-[20%] bg-[#0a0b0d]/80 px-2 py-0.5 text-[7px] md:text-[8px] font-mono text-[#e3dfd5]" style={`border-bottom: 2px solid ${proyecto.color}`}>
            SYSTEM_READER: GEN-KT-00{index+1}
          </div>
        </div>

        <!-- Tarjeta de Contenido con padding inferior seguro en móvil -->
        <div class="w-full md:w-[55%] flex-grow bg-[#0a0b0d] border-[1px] p-4 md:p-6 relative shadow-[20px_20px_50px_rgba(10,11,13,0.9)] flex flex-col justify-between mb-4 md:mb-0" style={`border-color: ${proyecto.color}60`}>
          
          <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${proyecto.color}; opacity: 0.8`}></div>
          <div class="absolute inset-0 bg-[linear-gradient(transparent_50%,rgba(10,11,13,0.8)_50%)] bg-[size:100%_4px] pointer-events-none z-0 opacity-40"></div>
          
          <div class="relative z-10 flex-grow">
            <div class="flex justify-between items-center text-[9px] md:text-[10px] font-mono text-[#e3dfd5]/50 mb-3 md:mb-4 border-b border-[#e3dfd5]/10 pb-2">
              <span>RECORD: {proyecto.id}</span>
              <div class="flex items-center gap-2">
                <span class={proyecto.tipoArchivo === 'NONE' ? "text-[#ff2a2a] animate-none" : "animate-pulse"} style={proyecto.tipoArchivo !== 'NONE' ? `color: ${proyecto.color}` : ''}>
                  {proyecto.tipoArchivo === 'NONE' ? 'SYSTEM_LOCKED' : 'SYSTEM_ACTIVE'}
                </span>
                <div class="w-2 h-2 rounded-full" style={`background-color: ${proyecto.tipoArchivo === 'NONE' ? '#ff2a2a' : proyecto.color}`}></div>
              </div>
            </div>

            <h3 class="text-2xl sm:text-3xl md:text-5xl font-black text-[#e3dfd5] tracking-tighter uppercase leading-[0.9] mb-2 md:mb-3" style={`text-shadow: 2px 2px 0px ${proyecto.color}60`}>
              {proyecto.cliente}
            </h3>
            
            <div class="inline-block bg-[#e3dfd5]/10 text-[#e3dfd5] border border-[#e3dfd5]/20 px-2 py-0.5 text-[9px] md:text-[10px] font-mono font-bold tracking-widest mb-3 md:mb-6 uppercase">
              {proyecto.categoria}
            </div>

            <div class="text-[8px] sm:text-[9px] md:text-[10px] font-mono text-[#e3dfd5]/70 mb-3 md:mb-4 bg-[#13151a]/60 p-2 border-l-2" style={`border-color: ${proyecto.tipoArchivo === 'NONE' ? '#ff2a2a' : proyecto.color}`}>
              <span class="text-[#e3dfd5] block mb-1 font-bold">TECH_SPECS //</span>
              {proyecto.specs}
            </div>

            <p class="text-xs sm:text-sm md:text-base text-[#e3dfd5]/80 font-sans leading-relaxed border-t border-[#e3dfd5]/10 pt-3 md:pt-4">
              {proyecto.review}
            </p>
          </div>

          <!-- BOTONES DE ACCIÓN -->
          <div class="relative z-10 mt-4 md:mt-6 flex flex-col gap-2 pb-2 md:pb-0">
            
            {proyecto.tipoArchivo === 'PDF' && (
              <button data-pdf={proyecto.archivoUrl} class="js-view-pdf-btn w-full py-2.5 md:py-3 bg-[#4ade80] hover:bg-[#ff8c33] text-[#0a0b0d] font-black text-[10px] md:text-[11px] uppercase tracking-widest transition-transform hover:-translate-y-1 shadow-[3px_3px_0px_#e3dfd5] md:shadow-[4px_4px_0px_#e3dfd5] flex items-center justify-center gap-2 pointer-events-auto">
                <span class="text-[#e3dfd5] font-mono bg-[#0a0b0d] px-1 py-0.5 text-[7px] md:text-[8px]">[.PDF]</span> VISUALIZAR_DATOS
              </button>
            )}

            {proyecto.tipoArchivo === 'WEB' && (
              <a href={proyecto.archivoUrl} target="_blank" rel="noopener noreferrer" class="w-full py-2.5 md:py-3 bg-[#4ade80] hover:bg-[#5cf090] text-[#0a0b0d] font-black text-[10px] md:text-[11px] uppercase tracking-widest transition-transform hover:-translate-y-1 shadow-[3px_3px_0px_#e3dfd5] md:shadow-[4px_4px_0px_#e3dfd5] flex items-center justify-center gap-2 pointer-events-auto">
                <span class="text-[#e3dfd5] font-mono bg-[#0a0b0d] px-1 py-0.5 text-[7px] md:text-[8px]">[WWW]</span> CONECTAR_ENLACE
              </a>
            )}

            {proyecto.tipoArchivo === 'NONE' && (
              <div class="w-full py-2.5 md:py-3 bg-[#13151a] border-2 border-dashed border-[#ff2a2a]/50 text-[#ff2a2a] font-mono text-[9px] md:text-[10px] uppercase tracking-widest flex items-center justify-center gap-2 cursor-not-allowed opacity-80 pointer-events-auto">
                <span>[!]</span> ARCHIVO_CLASIFICADO
