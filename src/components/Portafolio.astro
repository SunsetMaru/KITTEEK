                      {proyecto.tipoArchivo === 'NONE' ? 'SYSTEM_LOCKED' : 'SYSTEM_ACTIVE'}
                    </span>
                    <div class="w-2 h-2 rounded-full" style={`background-color: ${proyecto.tipoArchivo === 'NONE' ? '#ff2a2a' : proyecto.color}`}></div>
                  </div>
                </div>

                <h3 class="text-3xl md:text-5xl font-black text-[#e3dfd5] tracking-tighter uppercase leading-[0.9] mb-3" style={`text-shadow: 3px 3px 0px ${proyecto.color}60`}>
                  {proyecto.cliente}
                </h3>
                
                <div class="inline-block bg-[#e3dfd5]/10 text-[#e3dfd5] border border-[#e3dfd5]/20 px-2 py-0.5 text-[10px] font-mono font-bold tracking-widest mb-6 uppercase">
                  {proyecto.categoria}
                </div>

                <div class="text-[9px] md:text-[10px] font-mono text-[#e3dfd5]/70 mb-4 bg-[#13151a]/60 p-2 border-l-2" style={`border-color: ${proyecto.tipoArchivo === 'NONE' ? '#ff2a2a' : proyecto.color}`}>
                  <span class="text-[#e3dfd5] block mb-1 font-bold">TECH_SPECS //</span>
                  {proyecto.specs}
                </div>

                <p class="text-sm md:text-base text-[#e3dfd5]/80 font-sans leading-relaxed border-t border-[#e3dfd5]/10 pt-4">
                  {proyecto.review}
                </p>
              </div>

              <!-- LÓGICA CONDICIONAL DE BOTONES: VISOR DE PDF INCORPORADO -->
              <div class="relative z-10 mt-6 flex flex-col gap-2">
                
                {proyecto.tipoArchivo === 'PDF' && (
                  <button data-pdf={proyecto.archivoUrl} class="js-view-pdf-btn w-full py-3 bg-[#4ade80] hover:bg-[#ff8c33] text-[#0a0b0d] font-black text-[11px] uppercase tracking-widest transition-transform hover:-translate-y-1 shadow-[4px_4px_0px_#e3dfd5] flex items-center justify-center gap-2 pointer-events-auto">
                    <span class="text-[#e3dfd5] font-mono bg-[#0a0b0d] px-1 py-0.5 text-[8px]">[.PDF]</span> VISUALIZAR_DATOS
                  </button>
                )}

                {proyecto.tipoArchivo === 'WEB' && (
                  <a href={proyecto.archivoUrl} target="_blank" rel="noopener noreferrer" class="w-full py-3 bg-[#4ade80] hover:bg-[#5cf090] text-[#0a0b0d] font-black text-[11px] uppercase tracking-widest transition-transform hover:-translate-y-1 shadow-[4px_4px_0px_#e3dfd5] flex items-center justify-center gap-2 pointer-events-auto">
                    <span class="text-[#e3dfd5] font-mono bg-[#0a0b0d] px-1 py-0.5 text-[8px]">[WWW]</span> CONECTAR_ENLACE
                  </a>
                )}

                {proyecto.tipoArchivo === 'NONE' && (
                  <div class="w-full py-3 bg-[#13151a] border-2 border-dashed border-[#ff2a2a]/50 text-[#ff2a2a] font-mono text-[10px] uppercase tracking-widest flex items-center justify-center gap-2 cursor-not-allowed opacity-80 pointer-events-auto">
                    <span>[!]</span> ARCHIVO_CLASIFICADO
                  </div>
                )}

                <button class="js-close-btn w-full py-2 mt-1 bg-transparent hover:bg-[#e3dfd5]/5 border border-[#e3dfd5]/20 text-[#e3dfd5] font-mono text-[10px] uppercase tracking-widest transition-colors flex items-center justify-center gap-2 cursor-pointer pointer-events-auto">
                  <span class="text-[#ff2a2a] font-black">X</span> CERRAR_ARCHIVO
                </button>
              </div>
            </div>
          </div>
        </article>
      ))}

    </div>
  </div>

</section>

<div id="pdf-viewer-modal" class="fixed inset-0 z-[9999] bg-[#0a0b0d]/95 backdrop-blur-md hidden flex-col items-center justify-center p-2 md:p-6 opacity-0 transition-opacity duration-300">
  
  <div class="w-full max-w-[95vw] lg:max-w-[1400px] bg-[#4ade80] flex justify-between items-center px-4 py-3 border-x-4 border-t-4 border-[#0a0b0d]">
    <div class="flex items-center gap-2">
      <span class="w-3 h-3 bg-[#0a0b0d] rounded-full animate-pulse"></span>
      <span class="font-mono text-[#0a0b0d] font-black text-sm md:text-base tracking-widest">SYS_VIEWER // HIGH_RES_DATA</span>
    </div>
    
    <button id="close-pdf-modal" class="font-black text-[#0a0b0d] hover:text-[#e3dfd5] transition-colors text-sm md:text-base px-2 cursor-pointer">
      [X] CERRAR
    </button>
  </div>
  
  <div class="w-full max-w-[95vw] lg:max-w-[1400px] h-[90vh] bg-[#13151a] border-x-4 border-b-4 border-[#0a0b0d] relative shadow-[0_0_50px_rgba(255,115,0,0.2)] flex flex-col items-center overflow-auto custom-scrollbar" id="pdf-container">
     
     <div id="pdf-loader" class="absolute inset-0 flex flex-col items-center justify-center text-[#4ade80] bg-[#13151a] z-50 hidden">
