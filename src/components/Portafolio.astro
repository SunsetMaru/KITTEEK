---
// Portafolio.astro - ARCHIVO MODULAR
const proyectos = [
  { 
    id: "ARC-014", 
    cliente: "NEON NIGHTS", 
    categoria: "BRANDING", 
    color: "#EE8027", 
    img: "/ASSETS/IMG/CHAR1.png", 
    codigoCorto: "XX-990",
    specs: "DURACIÓN: 6-8 SEMANAS | FORMATO: VECTOR/DAT",
    review: "Reestructuración completa de la identidad visual corporativa para el sindicato underground Neon Nights. Incluye logos reactivos, manuales holográficos y paleta de neón para entornos de pulso electromagnético."
  },
  { 
    id: "ARC-025", 
    cliente: "CYBER_CORP", 
    categoria: "UI/UX_SYS", 
    color: "#64bbb3", 
    img: "/ASSETS/IMG/CHAR2.png",
    codigoCorto: "SYS-A",
    specs: "DURACIÓN: 10-12 SEMANAS | PROTOCOLO: NEURAL-LINK",
    review: "Arquitectura de interfaz para la terminal principal de Cyber_Corp. Navegación letal, animaciones fluidas a 120fps y una experiencia de usuario optimizada para implantes neuronales de última generación."
  },
  { 
    id: "ARC-099", 
    cliente: "MECHA PARTS", 
    categoria: "WEB_DEV", 
    color: "#EACCB0", 
    img: "/ASSETS/IMG/CHAR5.png",
    codigoCorto: "DEV-X",
    specs: "DURACIÓN: 8-10 SEMANAS | STACK: VUE/GSAP",
    review: "Plataforma de e-commerce de alta velocidad para la distribución global de piezas mecánicas clasificados. Base de datos encriptada y un DOM renderizado a la velocidad de la luz."
  },
  { 
    id: "ARC-000", 
    cliente: "STREET PUNKS", 
    categoria: "MOTION", 
    color: "#EE8027", 
    img: "/ASSETS/IMG/CHAR4.png",
    codigoCorto: "MOT-0",
    specs: "DURACIÓN: 4-6 SEMANAS | FPS: 60/120",
    review: "Cinemáticas promocionales agresivas y Motion Graphics para la campaña underground de Street Punks. Glitches controlados, modelado 3D y una estética visual que rompe la retina."
  },
  { 
    id: "ARC-007", 
    cliente: "GHOST DATA", 
    categoria: "SYSTEMS", 
    color: "#64bbb3", 
    img: "/ASSETS/IMG/CHAR3.png",
    codigoCorto: "GHS-7",
    specs: "DURACIÓN: CONTINUA | RATING: CLASE S",
    review: "Infiltración y optimización de servidores fantasma. Reestructuración de la arquitectura backend para garantizar un 99.9% de uptime bajo ataques masivos de denegación de servicio."
  }
];
---

<section id="portfolio" class="relative w-full font-sans select-none pt-32 pb-32 overflow-hidden bg-[#0a0a0a]">

  <div class="relative z-10 px-4 md:px-8 xl:px-0 max-w-[1500px] mx-auto w-full">
    
    <div class="mb-16 flex flex-col md:flex-row items-end justify-between border-b-[3px] border-[#EACCB0]/20 pb-4 relative">
      <div class="relative z-10">
        <h2 class="text-6xl md:text-7xl lg:text-8xl font-black tracking-tighter leading-[0.85] text-[#EACCB0] drop-shadow-[4px_4px_0px_#0a0a0a]">
          PROYECTOS<span class="text-transparent text-stroke-2 stroke-accent"> RECIENTES</span>
        </h2>
      </div>
      <p class="text-white/40 font-mono text-xs max-w-sm text-right mt-4 md:mt-0">
        > SELECCIONA UN CARTUCHO PARA CARGAR EL DISCO Y LEER LOS DATOS CLASIFICADOS.
      </p>
    </div>

    <div id="portfolio-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-y-16 gap-x-8 place-items-center relative z-10">
      
      {proyectos.map((proyecto, index) => (
        <article class="relative w-full max-w-[340px] aspect-[4/3] group cursor-pointer perspective-1000 z-10 js-project-card overflow-visible">
          
          <div class="card-closed absolute inset-0 transition-opacity duration-300">
            <div class="absolute top-[4%] bottom-[4%] right-[2%] aspect-square rounded-full shadow-[15px_15px_25px_rgba(0,0,0,0.9)] transition-all duration-[700ms] ease-[cubic-bezier(0.34,1.56,0.64,1)] group-hover:translate-x-[45%] group-hover:rotate-[180deg] group-hover:scale-[1.02] flex items-center justify-center border-[2px] border-black/90 z-0 bg-[#111]"
                 style={`-webkit-mask-image: radial-gradient(circle, transparent 13%, black 13.5%); mask-image: radial-gradient(circle, transparent 13%, black 13.5%); box-shadow: 0 0 0 2px ${proyecto.color}40 inset;`}>
              
              <img src={proyecto.img} alt={proyecto.cliente} class="absolute inset-0 w-full h-full object-cover opacity-70 mix-blend-luminosity contrast-[1.3] group-hover:opacity-100 transition-opacity" />
              <div class="absolute inset-0 mix-blend-color opacity-50" style={`background-color: ${proyecto.color};`}></div>

              <div class="absolute inset-0 border-[6px] border-black/40 rounded-full m-2 pointer-events-none"></div>
              <div class="absolute inset-0 border border-white/10 rounded-full m-0.5 pointer-events-none"></div>

              <div class="absolute top-2 w-full text-center text-[8px] font-mono font-black tracking-[0.2em] text-white/70 drop-shadow-md">
                {proyecto.codigoCorto}
              </div>
            </div>

            <div class="absolute inset-y-0 left-0 w-[86%] bg-[#0a0a0a] border-t-[2px] border-l-[2px] border-white/10 border-r-[4px] border-b-[4px] border-black shadow-[15px_15px_30px_rgba(0,0,0,0.9),inset_0_0_40px_rgba(0,0,0,0.6)] overflow-hidden flex z-20 clip-cartridge">
              
              <div class="w-10 h-full bg-[#111] flex flex-col items-center py-3 justify-between border-r border-white/5 relative z-30 shadow-[5px_0_10px_rgba(0,0,0,0.8)]">
                <div class="w-6 h-6 rounded-sm border-[2px] flex items-center justify-center text-black font-black text-[10px]" style={`background-color: ${proyecto.color}; border-color: ${proyecto.color};`}>
                  {index + 1}
                </div>
                <div class="transform -rotate-90 text-[8px] font-mono text-white/50 font-black tracking-[0.3em] whitespace-nowrap mt-8 w-[200px] text-center">
                  {proyecto.id}
                </div>
                <div class="w-full px-2 mt-auto opacity-30 flex flex-col gap-[2px]">
                  <div class="h-[2px] bg-white"></div><div class="h-[1px] bg-white"></div><div class="h-[3px] bg-white"></div><div class="h-[1px] bg-white"></div>
                </div>
              </div>

              <div class="flex-grow relative overflow-hidden bg-[#151515]">
                
                <img src={proyecto.img} alt="Cover" class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-30 contrast-[1.4] filter grayscale pointer-events-none" />
                <div class="absolute inset-0 mix-blend-multiply opacity-90" style={`background-color: ${proyecto.color};`}></div>
                <div class="absolute inset-0 bg-[radial-gradient(black_1px,transparent_1px)] [background-size:3px_3px] opacity-40"></div>

                <div class="relative z-30 h-full p-4 flex flex-col justify-between">
                  
                  <div class="flex justify-start items-start">
                    <span class="bg-black text-white px-1.5 py-0.5 text-[7px] font-mono tracking-widest uppercase border border-white/10 w-max shadow-sm">
                      {proyecto.codigoCorto}
                    </span>
                  </div>

                  <div class="mt-auto mb-3">
                    <h3 class="text-3xl md:text-4xl font-black text-white tracking-tighter leading-[0.85] uppercase drop-shadow-[2px_2px_0px_#000]">
                      {proyecto.cliente}
                    </h3>
                    <div class="flex items-center gap-2 mt-2">
                      <div class="h-[1.5px] w-6 bg-white"></div>
                      <span class="text-white font-mono text-[9px] font-bold tracking-[0.1em] uppercase bg-black px-1.5 py-0.5">{proyecto.categoria}</span>
                    </div>
                  </div>

                  <div class="flex justify-between items-end border-t border-white/10 pt-2">
                     <div class="flex gap-0.5">
                       <span class="w-3 h-3 bg-white text-black text-[6px] flex items-center justify-center font-black rounded-[2px]">A</span>
                       <span class="w-3 h-3 border border-white/30 text-white text-[6px] flex items-center justify-center font-black rounded-[2px]">B</span>
                     </div>
                     <span class="text-[6px] font-mono text-white/50 text-right max-w-[100px] uppercase">
                       SYS_KT_00{index+1}
                     </span>
                  </div>
                </div>

                <div class="absolute top-1/4 -right-10 w-[150%] h-5 transform rotate-[-35deg] border-y border-black shadow-[0_5px_15px_rgba(0,0,0,0.6)] z-40 opacity-90 mix-blend-hard-light" 
                     style={`background: repeating-linear-gradient(45deg, #000, #000 6px, ${proyecto.color} 6px, ${proyecto.color} 12px);`}>
                </div>

                <div class="absolute inset-0 bg-gradient-to-tr from-white/5 via-transparent to-white/10 pointer-events-none z-50"></div>
                <div class="absolute top-0 left-0 w-[200%] h-[200%] bg-gradient-to-b from-white/10 to-transparent transform -rotate-45 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-50"></div>
              </div>
            </div>
          </div>

          <div class="card-opened absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[280%] h-[180%] scale-0 opacity-0 pointer-events-none z-50 flex gap-12 items-center">
            
            <div class="detailed-disc w-[50%] aspect-square rounded-full flex items-center justify-center border-[4px] border-black/90 bg-[#111] shadow-[20px_20px_50px_rgba(0,0,0,0.8)] relative"
                 style={`-webkit-mask-image: radial-gradient(circle, transparent 13%, black 13.5%); mask-image: radial-gradient(circle, transparent 13%, black 13.5%); box-shadow: 0 0 0 4px ${proyecto.color}60 inset;`}>
              
              <img src={proyecto.img} alt={proyecto.cliente} class="absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-luminosity contrast-[1.3]" />
              <div class="absolute inset-0 mix-blend-color opacity-50" style={`background-color: ${proyecto.color};`}></div>
              
              <div class="absolute inset-0 border-[12px] border-black/50 rounded-full m-3 pointer-events-none"></div>
              <div class="absolute inset-0 border border-white/20 rounded-full m-1 pointer-events-none"></div>
              <div class="absolute inset-[25%] border-[2px] border-white/10 rounded-full pointer-events-none"></div>
              <div class="absolute inset-[35%] border-[1px] border-white/20 rounded-full pointer-events-none border-dashed"></div>

              <div class="absolute inset-[15%] rounded-full border border-white/5 opacity-40">
                <div class="w-full h-full transform rotate-[45deg] bg-[linear-gradient(45deg,transparent_45%,rgba(255,255,255,0.05)_50%,transparent_55%)]"></div>
              </div>

              <div class="absolute top-[20%] w-full text-center text-[10px] font-mono font-black tracking-[0.2em] text-white/90 drop-shadow-md">
                {proyecto.codigoCorto} // {proyecto.id}
              </div>
              <div class="absolute bottom-[20%] bg-black/80 px-2 py-0.5 text-[8px] font-mono text-white" style={`border-bottom: 2px solid ${proyecto.color}`}>
                SYSTEM_READER: GEN-KT-00{index+1}
              </div>
            </div>

            <div class="w-[50%] flex-grow bg-[#050505] border-[1px] p-6 relative shadow-[20px_20px_50px_rgba(0,0,0,0.9)]" style={`border-color: ${proyecto.color}60`}>
              
              <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${proyecto.color}; opacity: 0.8`}></div>
              <div class="absolute inset-0 bg-[linear-gradient(transparent_50%,rgba(0,0,0,0.8)_50%)] bg-[size:100%_4px] pointer-events-none z-0 opacity-40"></div>
              
              <div class="relative z-10">
                <div class="flex justify-between items-center text-[10px] font-mono text-white/50 mb-4 border-b border-white/10 pb-2">
                  <span>RECORD: {proyecto.id}</span>
                  <div class="flex items-center gap-2">
                    <span class="animate-pulse" style={`color: ${proyecto.color}`}>SYSTEM_ACTIVE</span>
                    <div class="w-2 h-2 rounded-full" style={`background-color: ${proyecto.color}`}></div>
                  </div>
                </div>

                <h3 class="text-3xl md:text-5xl font-black text-white tracking-tighter uppercase leading-[0.9] mb-3" style={`text-shadow: 3px 3px 0px ${proyecto.color}60`}>
                  {proyecto.cliente}
                </h3>
                
                <div class="inline-block bg-white/10 text-white border border-white/20 px-2 py-0.5 text-[10px] font-mono font-bold tracking-widest mb-6 uppercase">
                  {proyecto.categoria}
                </div>

                <div class="text-[9px] md:text-[10px] font-mono text-white/70 mb-4 bg-black/60 p-2 border-l-2" style={`border-color: ${proyecto.color}`}>
                  <span class="text-white block mb-1 font-bold">TECH_SPECS //</span>
                  {proyecto.specs}
                </div>

                <p class="text-sm md:text-base text-white/80 font-sans leading-relaxed border-t border-white/10 pt-4">
                  {proyecto.review}
                </p>

                <button class="js-close-btn mt-6 w-full py-2 bg-white/5 hover:bg-white/10 border border-white/20 text-white font-mono text-[10px] uppercase tracking-widest transition-colors flex items-center justify-center gap-2 cursor-pointer">
                  <span class="text-red-500 font-black">X</span> CERRAR_ARCHIVO
                </button>
              </div>
            </div>
          </div>
        </article>
      ))}

    </div>
  </div>

</section>

<style>
  .text-stroke-2 { -webkit-text-stroke: 1.5px; }
  .stroke-accent { -webkit-text-stroke-color: #EE8027; }
  .perspective-1000 { perspective: 1000px; }
  
  .clip-cartridge {
    clip-path: polygon(
      0 0, 
      calc(100% - 12px) 0, 
      100% 12px, 
      100% 100%, 
      0 100%
    );
  }
  
  .card-opened {
    visibility: hidden;
    pointer-events: none;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initPortfolio() {
    const cards = document.querySelectorAll('.js-project-card');
    let activeCard: HTMLElement | null = null;
    let isAnimating = false;

    gsap.from('.js-project-card', {
      scrollTrigger: {
        trigger: '#portfolio',
        start: 'top 70%',
      },
      y: 80,
      scale: 0.95,
      opacity: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: 'power3.out'
    });

    cards.forEach((cardEl) => {
      const card = cardEl as HTMLElement;
      const closedState = card.querySelector('.card-closed') as HTMLElement;
      const openedState = card.querySelector('.card-opened') as HTMLElement;
      const detailedDisc = card.querySelector('.detailed-disc') as HTMLElement;
      const closeBtn = card.querySelector('.js-close-btn') as HTMLElement;

      const toggleCard = (e?: Event) => {
        if (e) e.stopPropagation();
        if (isAnimating) return;
        
        const isOpening = activeCard !== card;

        if (isOpening) {
          isAnimating = true;
          activeCard = card;

          const rect = card.getBoundingClientRect();
          const targetX = (window.innerWidth / 2) - (rect.left + rect.width / 2);
          const targetY = (window.innerHeight / 2) - (rect.top + rect.height / 2);

          gsap.set(card, { zIndex: 50 });

          cards.forEach(c => {
            if (c !== card) {
              gsap.to(c, { opacity: 0, scale: 0.9, pointerEvents: 'none', duration: 0.4 });
            }
          });

          gsap.to(closedState, { opacity: 0, scale: 0.8, duration: 0.4, ease: "power2.in" });
          gsap.set(openedState, { visibility: 'visible', pointerEvents: 'auto' });
          
          gsap.to(card, {
            x: targetX,
            y: targetY,
            duration: 0.8,
            ease: "power4.out",
          });

          gsap.to(openedState, {
            opacity: 1,
            scale: 1,
            duration: 0.8,
            ease: "power4.out",
            delay: 0.1
          });

          gsap.fromTo(detailedDisc, { rotation: -180 }, {
            rotation: 0,
            duration: 1.2,
            ease: "back.out(1.4)",
            delay: 0.3,
            onComplete: () => { isAnimating = false; }
          });

        } else {
          isAnimating = true;
          activeCard = null;

          gsap.to(openedState, {
            opacity: 0,
            scale: 0.8,
            duration: 0.5,
            ease: "power3.in",
            onComplete: () => {
              gsap.set(openedState, { visibility: 'hidden', pointerEvents: 'none' });
            }
          });

          gsap.to(card, {
            x: 0,
            y: 0,
            duration: 0.8,
            ease: "power3.inOut",
            onComplete: () => {
              gsap.set(card, { zIndex: 10 });
              isAnimating = false;
            }
          });

          gsap.to(closedState, {
            opacity: 1,
            scale: 1,
            duration: 0.6,
            delay: 0.2,
            ease: "power2.out"
          });

          cards.forEach(c => {
            if (c !== card) {
              gsap.to(c, { opacity: 1, scale: 1, pointerEvents: 'auto', duration: 0.5, delay: 0.3 });
            }
          });
        }
      };

      card.addEventListener('click', () => {
        if (!activeCard) {
          toggleCard();
        }
      });

      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          if (activeCard === card) toggleCard(e);
        });
      }
    });

    document.addEventListener('click', (e) => {
      if (activeCard && !isAnimating) {
        const target = e.target as HTMLElement;
        if (!activeCard.contains(target)) {
          const closeBtn = activeCard.querySelector('.js-close-btn') as HTMLElement;
          if (closeBtn) closeBtn.click();
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initPortfolio);
  document.addEventListener('astro:page-load', initPortfolio);
</script>