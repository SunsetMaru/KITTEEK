                  </div>
                </div>

                <div class="absolute top-1/4 -right-10 w-[150%] h-5 transform rotate-[-35deg] border-y border-[#0a0b0d] shadow-[0_5px_15px_rgba(10,11,13,0.6)] z-40 opacity-90 mix-blend-hard-light" 
                     style={`background: repeating-linear-gradient(45deg, #0a0b0d, #0a0b0d 6px, ${proyecto.color} 6px, ${proyecto.color} 12px);`}>
                </div>

                <div class="absolute inset-0 bg-gradient-to-tr from-[#e3dfd5]/5 via-transparent to-[#e3dfd5]/10 pointer-events-none z-50"></div>
                <div class="absolute top-0 left-0 w-[200%] h-[200%] bg-gradient-to-b from-[#e3dfd5]/10 to-transparent transform -rotate-45 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-50"></div>
              </div>
            </div>
          </div>

          <div class="card-opened absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[280%] h-[180%] scale-0 opacity-0 pointer-events-none z-50 flex gap-12 items-center">
            
            <div class="detailed-disc w-[50%] aspect-square rounded-full flex items-center justify-center border-[4px] border-[#0a0b0d]/90 bg-[#13151a] shadow-[20px_20px_50px_rgba(10,11,13,0.8)] relative"
                 style={`-webkit-mask-image: radial-gradient(circle, transparent 13%, black 13.5%); mask-image: radial-gradient(circle, transparent 13%, black 13.5%); box-shadow: 0 0 0 4px ${proyecto.color}60 inset;`}>
              
              <img src={proyecto.img} alt={proyecto.cliente} class="absolute inset-0 w-full h-full object-cover opacity-80 mix-blend-luminosity contrast-[1.3]" />
              <div class="absolute inset-0 mix-blend-color opacity-50" style={`background-color: ${proyecto.color};`}></div>
              
              <div class="absolute inset-0 border-[12px] border-[#0a0b0d]/50 rounded-full m-3 pointer-events-none"></div>
              <div class="absolute inset-0 border border-[#e3dfd5]/20 rounded-full m-1 pointer-events-none"></div>
              <div class="absolute inset-[25%] border-[2px] border-[#e3dfd5]/10 rounded-full pointer-events-none"></div>
              <div class="absolute inset-[35%] border-[1px] border-[#e3dfd5]/20 rounded-full pointer-events-none border-dashed"></div>

              <div class="absolute inset-[15%] rounded-full border border-[#e3dfd5]/5 opacity-40">
                <div class="w-full h-full transform rotate-[45deg] bg-[linear-gradient(45deg,transparent_45%,rgba(227,223,213,0.05)_50%,transparent_55%)]"></div>
              </div>

              <div class="absolute top-[20%] w-full text-center text-[10px] font-mono font-black tracking-[0.2em] text-[#e3dfd5]/90 drop-shadow-md">
                {proyecto.codigoCorto} // {proyecto.id}
              </div>
              <div class="absolute bottom-[20%] bg-[#0a0b0d]/80 px-2 py-0.5 text-[8px] font-mono text-[#e3dfd5]" style={`border-bottom: 2px solid ${proyecto.color}`}>
                SYSTEM_READER: GEN-KT-00{index+1}
              </div>
            </div>

            <div class="w-[50%] flex-grow bg-[#0a0b0d] border-[1px] p-6 relative shadow-[20px_20px_50px_rgba(10,11,13,0.9)] flex flex-col" style={`border-color: ${proyecto.color}60`}>
              
              <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${proyecto.color}; opacity: 0.8`}></div>
              <div class="absolute inset-0 bg-[linear-gradient(transparent_50%,rgba(10,11,13,0.8)_50%)] bg-[size:100%_4px] pointer-events-none z-0 opacity-40"></div>
              
              <div class="relative z-10 flex-grow">
                <div class="flex justify-between items-center text-[10px] font-mono text-[#e3dfd5]/50 mb-4 border-b border-[#e3dfd5]/10 pb-2">
                  <span>RECORD: {proyecto.id}</span>
